{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afmarbre-support",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",

  // The Worker is the origin for the complete support subdomain.
  // Cloudflare creates/manages the DNS record and TLS certificate.
  "routes": [
    {
      "pattern": "support.afmarbre.com",
      "custom_domain": true
    }
  ],

  // Production is served only from the branded custom domain.
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    // Public Turnstile site key. Create the widget for support.afmarbre.com.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAELV-6t0f-Bafy_y",
    "TURNSTILE_HOSTNAMES": "support.afmarbre.com",
    // Existing A-F Marbre API Worker. It owns the Resend API key.
    "SUPPORT_API_URL": "https://api.afmarbre.com/api/support"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "SUPPORT_API_TOKEN"
    ]
  }
}
