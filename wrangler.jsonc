{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afmarbre-support",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",

  // The Worker is the origin for the complete support subdomain.
  // Cloudflare creates/manages the DNS record and TLS certificate.
  "routes": [
    {
      "pattern": "support.afmarbre.com",
      "custom_domain": true
    }
  ],

  // Production is served only from the branded custom domain.
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    // Public Turnstile site key. Create the widget for support.afmarbre.com.
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_YOUR_TURNSTILE_SITE_KEY",
    "TURNSTILE_HOSTNAMES": "support.afmarbre.com",

    // SUPPORT_TO must be a verified destination in Cloudflare Email Service.
    "SUPPORT_TO": "fayt7304@gmail.com",

    // This sender domain must be onboarded for Cloudflare Email Service.
    "SUPPORT_FROM": "support@afmarbre.com"
  },

  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "fayt7304@gmail.com",
      "allowed_sender_addresses": [
        "support@afmarbre.com"
      ]
    }
  ]
}
